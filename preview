  .chart-label { font-size: 11px; font-weight: 800; color: var(--muted); }
  .chart-val { font-size: 11px; font-weight: 800; position: absolute;
    top: -18px; left: 50%; transform: translateX(-50%); color: var(--navy); }

  /* RECEIPT */
  .receipt {
    background: #FFFDF7; border: 3px dashed var(--border); border-radius: var(--r);
