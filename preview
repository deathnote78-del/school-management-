  .btn-sun { background: var(--sun); color: var(--navy); box-shadow: 0 4px 0 rgba(255,193,7,0.4); }
  .btn-sun:hover { transform: translateY(-2px); box-shadow: 0 6px 0 rgba(255,193,7,0.4); }
  .btn-coral { background: var(--coral); color: white; box-shadow: 0 4px 0 rgba(255,107,107,0.35); }
