      </div>

      <div className="card">
        {loading ? <Spinner /> : users.length === 0 ? <EmptyState text={`No ${filterRole}s found`} /> : (
          <div className="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  {filterRole === 'student' && <th>Class</th>}
                  <th>Joined</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {users.map(u => (
                  <tr key={u.id}>
                    <td style={{ color: 'var(--text-primary)', fontWeight: 500 }}>{u.name}</td>
                    <td>{u.email}</td>
                    <td><StatusBadge status={u.role} /></td>
