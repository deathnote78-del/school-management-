/* ─── ATTENDANCE PAGE ────────────────────────────────────────────── */
function AttendancePage() {
  const [classes, setClasses] = useState([]);
  const [selectedClass, setSelectedClass] = useState('');
  const [students, setStudents] = useState([]);
  const [date, setDate] = useState(new Date().toISOString().slice(0, 10));
  const [records, setRecords] = useState({});
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);

  useEffect(() => { api.get('/classes').then(setClasses); }, []);

  useEffect(() => {
    if (!selectedClass) return;
    api.get(`/classes/${selectedClass}/students`).then(ss => {
      setStudents(ss);
      const r = {};
      ss.forEach(s => { r[s.id] = 'present'; });
      setRecords(r);
    });
  }, [selectedClass]);

  const handleMark = async () => {
    if (!selectedClass || !Object.keys(records).length) return;
    setSaving(true);
    try {
      await api.post('/attendance', {
        class_id: selectedClass,
        date,
        records: Object.entries(records).map(([student_id, status]) => ({ student_id, status }))
      });
      setSaved(true);
      setTimeout(() => setSaved(false), 3000);
    } catch (err) { alert(err.message); }
    finally { setSaving(false); }
  };

  return (
    <div className="fade-in">
      <div className="card" style={{ marginBottom: 16 }}>
        <div className="form-row">
          <div className="form-group" style={{ marginBottom: 0 }}>
            <label className="form-label">Select Class</label>
            <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)}>
              <option value="">Choose class...</option>
              {classes.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div className="form-group" style={{ marginBottom: 0 }}>
            <label className="form-label">Date</label>
            <input type="date" value={date} onChange={e => setDate(e.target.value)} />
          </div>
        </div>
      </div>

      {selectedClass && students.length > 0 && (
        <div className="card">
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
            <div className="card-title" style={{ margin: 0 }}>
              <Icon name="attend" size={16} /> {students.length} Students
            </div>
            <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
              {saved && <span className="badge badge-green"><Icon name="check" size={11} /> Saved!</span>}
              <button className="btn btn-primary" onClick={handleMark} disabled={saving}>
                {saving ? 'Saving...' : 'Save Attendance'}
              </button>
            </div>
          </div>

          <div style={{ display: 'flex', gap: 8, marginBottom: 12 }}>
            {['present', 'absent', 'late'].map(s => (
              <button key={s} className="btn btn-ghost btn-sm" onClick={() => {
                const r = {}; students.forEach(st => { r[st.id] = s; }); setRecords(r);
              }} style={{ textTransform: 'capitalize' }}>Mark All {s}</button>
            ))}
          </div>

          <div className="table-wrap">
            <table>
              <thead>
                <tr><th>#</th><th>Student Name</th><th>Status</th></tr>
              </thead>
              <tbody>
                {students.map((s, i) => (
                  <tr key={s.id}>
                    <td style={{ color: 'var(--text-muted)', width: 40 }}>{i + 1}</td>
                    <td style={{ color: 'var(--text-primary)', fontWeight: 500 }}>{s.name}</td>
                    <td>
                      <select className="att-status-select"
                        value={records[s.id] || 'present'}
                        onChange={e => setRecords(r => ({ ...r, [s.id]: e.target.value }))}
                        style={{ width: 130, padding: '5px 8px',
                          color: records[s.id] === 'present' ? 'var(--green)' : records[s.id] === 'absent' ? 'var(--red)' : 'var(--amber)' }}>
                        <option value="present">✓ Present</option>
                        <option value="absent">✗ Absent</option>
                        <option value="late">~ Late</option>
                      </select>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {selectedClass && students.length === 0 && <EmptyState text="No students in this class" />}
    </div>
  );
}

