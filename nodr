        <div key={a.id} className="card" style={{ marginBottom: 10, borderLeft: '3px solid var(--accent)' }}>
          <div style={{ fontWeight: 600, marginBottom: 4 }}>{a.title}</div>
          <p style={{ fontSize: 13, color: 'var(--text-secondary)' }}>{a.content}</p>
        </div>
      ))}
    </div>
  );
}

/* ─── TEACHER DASHBOARD ──────────────────────────────────────────── */
function TeacherDashboard() {
  const [classes, setClasses] = useState([]);
  const [ann, setAnn] = useState([]);
  useEffect(() => {
    api.get('/classes').then(setClasses).catch(() => {});
    api.get('/announcements').then(setAnn).catch(() => {});
  }, []);

  return (
    <div className="fade-in">
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 14, marginBottom: 20 }}>
        <div className="stat-card">
          <div className="stat-label">Your Classes</div>
          <div className="stat-value" style={{ color: 'var(--accent)' }}>{classes.length}</div>
        </div>
        <div className="stat-card">
          <div className="stat-label">Announcements</div>
          <div className="stat-value" style={{ color: 'var(--blue)' }}>{ann.length}</div>
        </div>
      </div>
      <div className="card">
        <div className="card-title">Classes Overview</div>
        {!classes.length ? <EmptyState text="No classes assigned" /> : (
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))', gap: 10 }}>
            {classes.map(c => (
              <div key={c.id} style={{ background: 'var(--bg-elevated)', border: '1px solid var(--border)', borderRadius: 8, padding: 14 }}>
                <div style={{ fontWeight: 700, fontSize: 16 }}>{c.name}</div>
                <div style={{ color: 'var(--text-muted)', fontSize: 12, marginTop: 4 }}>{c.student_count} students</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

/* ─── APP SHELL ──────────────────────────────────────────────────── */
function pageTitle(id) {
  const titles = { dashboard: 'Dashboard', students: 'Students', teachers: 'Teachers', classes: 'Classes', attendance: 'Attendance', results: 'Upload Results', fees: 'Fee Structures', payments: 'Payments', announcements: 'Announcements', myresults: 'My Results', myfees: 'My Fees' };
  return titles[id] || 'Dashboard';
}

function AppShell() {
  const { user } = useAuth();
  const [active, setActive] = useState('dashboard');

  const renderPage = () => {
    switch (active) {
      case 'dashboard':
        if (user.role === 'admin') return <AdminDashboard />;
        if (user.role === 'teacher') return <TeacherDashboard />;
        if (user.role === 'bursar') return <BursarDashboard />;
        return <StudentDashboard />;
      case 'students': return <UsersPage role="student" />;
      case 'teachers': return <UsersPage role="teacher" />;
      case 'classes': return <ClassesPage />;
      case 'attendance': return <AttendancePage />;
      case 'results': return <ResultsPage />;
      case 'fees': return <FeesPage />;
      case 'payments': return <PaymentsPage />;
      case 'announcements': return <AnnouncementsPage />;
      case 'myresults': return <StudentResultsPage />;
      case 'myfees': return <StudentFeesPage />;
      default: return <AdminDashboard />;
    }
  };

  return (
    <div className="layout">
      <Sidebar active={active} setActive={setActive} />
      <div className="main">
        <div className="topbar">
          <h1 className="topbar-title">{pageTitle(active)}</h1>
          <div className="topbar-actions">
            <span style={{ fontSize: 12, color: 'var(--text-muted)' }}>{new Date().toLocaleDateString('en-NG', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
        <div className="page-content">
          {renderPage()}
        </div>
      </div>
    </div>
  );
}

/* ─── ROOT ───────────────────────────────────────────────────────── */
export default function App() {
  const { user, loading } = useAuth();
  if (loading) return <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: '100vh', background: 'var(--bg-base)', color: 'var(--text-secondary)', fontSize: 14 }}>Loading...</div>;
  return user ? <AppShell /> : <LoginPage />;
}

export function Root() {
  return (
    <>
      <style>{css}</style>
      <AuthProvider>
        <App />
      </AuthProvider>
    </>
  );
}
