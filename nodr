                      <td><input type="number" min="0" max="60" style={{ width: 80 }}
                        value={scores[s.id]?.exam_score || ''}
                        onChange={e => setScores(r => ({ ...r, [s.id]: { ...r[s.id], exam_score: e.target.value } }))} /></td>
                      <td style={{ fontWeight: 700, color: 'var(--text-primary)' }}>{total}</td>
                      <td><span style={{ fontWeight: 700, color: c, fontSize: 16 }}>{g}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  );
}

