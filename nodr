function ResultsPage() {
  const [classes, setClasses] = useState([]);
  const [selectedClass, setSelectedClass] = useState('');
  const [subjects, setSubjects] = useState([]);
  const [selectedSubject, setSelectedSubject] = useState('');
  const [students, setStudents] = useState([]);
  const [scores, setScores] = useState({});
  const [term, setTerm] = useState('First Term');
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);

  useEffect(() => { api.get('/classes').then(setClasses); }, []);
  useEffect(() => {
    if (!selectedClass) return;
    api.get(`/classes/${selectedClass}/subjects`).then(setSubjects);
    api.get(`/classes/${selectedClass}/students`).then(ss => {
      setStudents(ss);
      const s = {};
      ss.forEach(st => { s[st.id] = { ca_score: '', exam_score: '' }; });
      setScores(s);
    });
  }, [selectedClass]);

  const getGrade = (total) => {
    if (total >= 75) return { g: 'A', c: 'var(--green)' };
    if (total >= 65) return { g: 'B', c: 'var(--blue)' };
    if (total >= 55) return { g: 'C', c: 'var(--cyan)' };
    if (total >= 45) return { g: 'D', c: 'var(--amber)' };
    return { g: 'F', c: 'var(--red)' };
  };

  const handleSave = async () => {
    if (!selectedClass || !selectedSubject) return alert('Select class and subject');
    setSaving(true);
    try {
      await api.post('/results', {
        subject_id: selectedSubject,
        class_id: selectedClass,
        term,
        academic_year: '2024/2025',
        scores: students.map(s => ({
          student_id: s.id,
          ca_score: parseFloat(scores[s.id]?.ca_score || 0),
          exam_score: parseFloat(scores[s.id]?.exam_score || 0),
        }))
      });
      setSaved(true); setTimeout(() => setSaved(false), 3000);
    } catch (err) { alert(err.message); }
    finally { setSaving(false); }
  };

  return (
    <div className="fade-in">
      <div className="card" style={{ marginBottom: 16 }}>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: 12 }}>
          <div className="form-group" style={{ marginBottom: 0 }}>
            <label className="form-label">Class</label>
            <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)}>
              <option value="">Select class...</option>
              {classes.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div className="form-group" style={{ marginBottom: 0 }}>
            <label className="form-label">Subject</label>
            <select value={selectedSubject} onChange={e => setSelectedSubject(e.target.value)}>
              <option value="">Select subject...</option>
              {subjects.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
            </select>
          </div>
          <div className="form-group" style={{ marginBottom: 0 }}>
            <label className="form-label">Term</label>
            <select value={term} onChange={e => setTerm(e.target.value)}>
              <option>First Term</option><option>Second Term</option><option>Third Term</option>
            </select>
          </div>
        </div>
      </div>

      {selectedClass && students.length > 0 && (
